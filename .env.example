# 64 hex characters (32 bytes) for AES-256-GCM token encryption
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=

# Webhook signature validation secret
# OPENBANKING_WEBHOOK_SECRET_PREVIOUS is optional — set it during a secret rotation so
# in-flight webhooks signed with the old secret still verify for a transition period.
OPENBANKING_WEBHOOK_SECRET=
OPENBANKING_WEBHOOK_SECRET_PREVIOUS=

# Session cookie signing secret (min 32 chars). Generate via: openssl rand -hex 32
SESSION_SECRET=

# Shared demo password accepted by /api/auth/login for ANY email. There is no per-user
# password store in this project yet — see src/app/api/auth/login/route.ts for why, and
# replace this before handling real user accounts.
DEMO_PASSWORD=

# Comma-separated emails granted admin access (/admin/*, /api/admin/*) after login.
ADMIN_EMAILS=adekunle@mymoney.ng
