# 64 hex characters (32 bytes) for AES-256-GCM token encryption
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=

# Webhook signature validation secret
# OPENBANKING_WEBHOOK_SECRET_PREVIOUS is optional — set it during a secret rotation so
# in-flight webhooks signed with the old secret still verify for a transition period.
OPENBANKING_WEBHOOK_SECRET=
OPENBANKING_WEBHOOK_SECRET_PREVIOUS=

# Session cookie signing secret (min 32 chars). Generate via: openssl rand -hex 32
SESSION_SECRET=

# Shared demo password accepted by /api/auth/login for ANY email (also used as the
# initial password when running prisma db seed). Replace before real user accounts.
DEMO_PASSWORD=

# Comma-separated emails granted admin access (/admin/*, /api/admin/*) after login.
ADMIN_EMAILS=adekunle@mymoney.ng

# ── PostgreSQL / Prisma ────────────────────────────────────────────────────────
# Full connection string. Neon, Supabase, Railway, or local Postgres all work.
# Example: postgresql://postgres:password@localhost:5432/mymoney
DATABASE_URL=

# ── Mono Open Banking ─────────────────────────────────────────────────────────
# Get these from https://app.withmono.com → Settings → API Keys
# MONO_SECRET_KEY   — server-side only (never expose to browser)
# MONO_WEBHOOK_SECRET — used to verify inbound webhook signatures from Mono
# NEXT_PUBLIC_MONO_PUBLIC_KEY — injected into the Mono Connect widget (browser-safe)
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
NEXT_PUBLIC_MONO_PUBLIC_KEY=
